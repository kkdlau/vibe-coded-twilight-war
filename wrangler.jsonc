{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twilight-wars",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
